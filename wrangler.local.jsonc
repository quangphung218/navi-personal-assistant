// Local readiness probe only. Do not use this config for cloud deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-assistant-local",
  "main": "src/entrypoints/environment.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_STAGE": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-assistant-local",
      "database_id": "local-only-not-a-cloud-resource",
      "remote": false
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
